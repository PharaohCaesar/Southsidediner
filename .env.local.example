# Copy to .env.local. Never commit .env.local.

# Where the Akelt ordering site for this restaurant lives (no trailing slash). The widget,
# pop-ups, live hours and the menu JSON all come from here.
NEXT_PUBLIC_AKELT_ORIGIN=https://akelt-ordering.vercel.app

# Public site URL (canonicals, sitemap, share cards).
NEXT_PUBLIC_SITE_URL=https://southsidediner.net

# Resend — contact + job application forms. Forms return 503 "being set up" until set.
RESEND_API_KEY=
RESEND_FROM="Southside Diner <web@southsidediner.net>"
LEADS_TO=southsidedinerparma@gmail.com
